# Homebrew bootstrap for ink-capture local dev.
# Run `brew bundle` once on a fresh machine, then `bash scripts/setup.sh`.
# Xcode (+ a Simulator runtime) and Android Studio (SDK/NDK) are installed
# separately — see README "Getting Started".

brew "watchman" # Metro file watching
brew "nvm"      # Node version manager (Node 20 pinned in .nvmrc)
cask "zulu@17"  # JDK 17 for the Android build (Gradle)
