# ------------------------------------------------------------------------------
# Example environment configuration for ink-capture.
#
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Keep this file up to date as new required variables are introduced.
# All values below are placeholders/commented out — nothing here is a real secret.
# ------------------------------------------------------------------------------

# --- Recognition (vision) backend ---------------------------------------------
# API key for the cloud recognition backend, if/when a cloud vision API
# (e.g. Scrydex Vision) is the selected CardRecognizer. Pending confirmation —
# see CLAUDE.md "ask-first" rules before adopting a paid backend.
# RECOGNITION_API_KEY=your-recognition-api-key-here

# Optional: override the recognition service base URL.
# RECOGNITION_API_BASE_URL=https://api.example-vision-service.com

# --- Card catalog -------------------------------------------------------------
# Base URL for the Lorcana card-metadata catalog API (e.g. Lorcast /
# lorcana-api.com). Card data is fetched and cached at runtime, never bundled.
# CATALOG_API_BASE_URL=https://api.lorcast.com/v0
