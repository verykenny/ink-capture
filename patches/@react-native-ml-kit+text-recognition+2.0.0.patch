-@implementation TextRecognition
+@implementation TextRecognition {
+    // One MLKTextRecognizer per script, reused across calls. The original wrapper
+    // allocated a fresh recognizer for every recognize() call; each one carries a
+    // native (Metal-backed) inference pipeline, and creating them per-call leaks
+    // those resources until the app restarts — after a few captures the engine
+    // starts returning empty/garbage text. ML Kit's own guidance is to create a
+    // detector once and reuse it, which is exactly what this cache does.
+    NSMutableDictionary<NSString *, MLKTextRecognizer *> *_recognizers;
+}
 
 RCT_EXPORT_MODULE()
 
+// Lazily build (and then reuse) the recognizer for a script. Returns nil for an
+// unsupported script so the caller can reject. Guarded by @synchronized so a
+// race never double-creates a cached recognizer.
+- (MLKTextRecognizer *)recognizerForScript:(NSString *)script {
+    NSString *key = (script == nil) ? @"Latin" : script;
+    @synchronized (self) {
+        if (_recognizers == nil) {
+            _recognizers = [NSMutableDictionary dictionary];
+        }
+        MLKTextRecognizer *cached = _recognizers[key];
+        if (cached != nil) {
+            return cached;
+        }
+
+        MLKCommonTextRecognizerOptions *options = nil;
+        if ([key isEqualToString:@"Latin"]) {
+            options = [[MLKTextRecognizerOptions alloc] init];
+        } else if ([key isEqualToString:@"Chinese"]) {
+            options = [[MLKChineseTextRecognizerOptions alloc] init];
+        } else if ([key isEqualToString:@"Devanagari"]) {
+            options = [[MLKDevanagariTextRecognizerOptions alloc] init];
+        } else if ([key isEqualToString:@"Japanese"]) {
+            options = [[MLKJapaneseTextRecognizerOptions alloc] init];
+        } else if ([key isEqualToString:@"Korean"]) {
+            options = [[MLKKoreanTextRecognizerOptions alloc] init];
+        } else {
+            return nil;
+        }
+
+        MLKTextRecognizer *recognizer = [MLKTextRecognizer textRecognizerWithOptions:options];
+        _recognizers[key] = recognizer;
+        return recognizer;
+    }
+}
